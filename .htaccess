<IfModule mod_rewrite.c>
    AddHandler application/x-httpd-ea-php84 .php .php8 .phtml
    RewriteEngine On

    # 1. Redirigir todas las peticiones a la carpeta public/ sin mostrarla en la URL
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]

</IfModule>

# 2. Seguridad: Denegar acceso directo a archivos sensibles de configuración
<FilesMatch "^\.env|composer\.json|composer\.lock|package\.json|package-lock\.json|artisan|phpunit\.xml|Dockerfile|docker-compose\.yml">
    Order allow,deny
    Deny from all
</FilesMatch>

# 3. Seguridad: Denegar acceso a carpetas del sistema
RedirectMatch 404 ^/\.(git|github|cursor|vscode|zed)/

# OJO: 'storage' NO va en esta lista. /storage/ es el enlace simbólico public/storage
# que sirve las evidencias de autoevaluación, los logos de la landing, el flujograma
# de crisis y los materiales de apoyo. Bloquearlo aquí provoca un 404 de Apache antes
# de que la regla 1 pueda reescribir la petición hacia public/.
RedirectMatch 404 ^/(app|bootstrap|config|database|resources|routes|tests|vendor)/

# El storage interno del framework (logs, caché, sesiones) sí se bloquea de forma
# explícita, por si mod_rewrite estuviera deshabilitado y la regla 1 no se aplicara.
RedirectMatch 404 ^/storage/(framework|logs|app/private)/

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php84” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php84 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

